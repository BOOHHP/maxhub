<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MaxHub Connector 构建矩阵骨架。
    需要各年份 3ds Max SDK：以 -p:MaxYear=2024 -p:MaxSdkDir=<sdk路径> 构建。
    本项目不加入 MaxHub.sln，避免无 SDK 环境下阻塞 CI。
  -->
  <PropertyGroup>
    <MaxYear Condition="'$(MaxYear)' == ''">2024</MaxYear>
    <!-- 2019-2021: .NET Framework 4.7；2022-2026: 4.8 -->
    <TargetFramework Condition="'$(MaxYear)' &lt;= '2021'">net47</TargetFramework>
    <TargetFramework Condition="'$(MaxYear)' &gt;= '2022'">net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MaxHubConnector</AssemblyName>
    <RootNamespace>MaxHub.Connector</RootNamespace>
    <DefineConstants>$(DefineConstants);MAX$(MaxYear)</DefineConstants>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputPath>bin\$(Configuration)\max$(MaxYear)\</OutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(MaxSdkDir)' != ''">
    <Reference Include="Autodesk.Max">
      <HintPath>$(MaxSdkDir)\Autodesk.Max.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
