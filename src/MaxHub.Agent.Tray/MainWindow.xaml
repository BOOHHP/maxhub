<Window x:Class="MaxHub.Agent.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MaxHub.Agent.Tray"
        Title="MaxHub Agent" Width="900" Height="600"
        MinWidth="760" MinHeight="520"
        Icon="Assets/maxhub.ico"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource Bg.Sidebar}" MouseLeftButtonDown="TitleBar_MouseDown">
            <DockPanel>
            <Border Width="18" Height="18" Background="{StaticResource Bg.Window}" CornerRadius="4"
                VerticalAlignment="Center" Margin="10,0,8,0">
                <Grid>
                <Path Stroke="{StaticResource Accent.Primary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M9,9 L3,3 M9,9 L3,15 M9,9 L16,9"/>
                <Border Width="4" Height="4" Background="{StaticResource Accent.Primary}" CornerRadius="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
                <Border Width="4" Height="4" Background="{StaticResource Accent.Primary}" CornerRadius="1"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                <Border Width="4" Height="4" Background="{StaticResource Accent.Primary}" CornerRadius="1"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"/>
                <Border Width="7" Height="7" Background="{StaticResource Text.Primary}" CornerRadius="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
                <TextBlock Text="MaxHub Agent" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="─" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="▢" Click="Maximize_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource Bg.Sidebar}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                        <RadioButton x:Name="NavReleaseNotes" Style="{StaticResource NavButton}" Content="📝"
                                     GroupName="Nav" Checked="NavReleaseNotes_Checked"
                                     ToolTip="更新日志" AutomationProperties.Name="更新日志"/>
                        <TextBlock x:Name="VersionText" Text="v?" FontSize="10"
                                   Foreground="{StaticResource Text.Disabled}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <RadioButton x:Name="NavAccount" Style="{StaticResource NavButton}" Content="👤"
                                     GroupName="Nav" Checked="NavAccount_Checked" ToolTip="账号"/>
                        <RadioButton x:Name="NavConnectors" Style="{StaticResource NavButton}" Content="🔌"
                                     GroupName="Nav" Checked="NavConnectors_Checked" ToolTip="Connector 管理"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavButton}" Content="🧰"
                                     GroupName="Nav" Checked="NavTools_Checked" ToolTip="工具管理"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 账号页 -->
            <Grid Grid.Column="1" x:Name="AccountPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">

                    <!-- 未登录态 -->
                    <StackPanel x:Name="LoggedOutPanel">
                        <TextBlock Text="🔗" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="使用飞书账号登录 MaxHub" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="登录后即可为本机安装 Max 插件面板" Foreground="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center" Margin="0,6,0,20"/>
                        <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Status.Warning}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Button Content="🔗 飞书扫码登录" Style="{StaticResource PrimaryButton}"
                                Width="200" Height="40" FontSize="14" Command="{Binding LoginCommand}"/>
                        <TextBlock Text="将打开浏览器完成授权，请勿关闭本窗口" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- 登录中态 -->
                    <StackPanel x:Name="WaitingPanel" Visibility="Collapsed">
                        <TextBlock Text="◌ 等待浏览器授权中…" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="请在打开的浏览器页面中用飞书 App 扫码" Foreground="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center" Margin="0,10,0,20"/>
                        <Button Content="取消" Style="{StaticResource OutlineButton}" Width="80"
                                HorizontalAlignment="Center" Command="{Binding CancelLoginCommand}"/>
                    </StackPanel>

                    <!-- 已登录态 -->
                    <StackPanel x:Name="LoggedInPanel" Visibility="Collapsed">
                        <TextBlock Text="{Binding Username}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Text="{Binding EmployeeId, StringFormat=员工ID：{0}}"/>
                        <TextBlock Text="✓ 登录有效，自动续期中" FontSize="12" Foreground="{StaticResource Status.Success}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,14,0,20"
                                   Text="{Binding ServerUrl, StringFormat=服务器：{0}}"/>
                        <Button Content="退出登录" Style="{StaticResource DangerOutlineButton}" Width="120" Height="32"
                                HorizontalAlignment="Center" Command="{Binding LogoutCommand}"
                                Visibility="{Binding ConfirmingLogout, Converter={StaticResource InverseBoolToVis}}"/>
                        <!-- 内联二次确认：退出后 Connector 面板也会失效，误触成本高 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding ConfirmingLogout, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="确认退出？退出后 Max 内面板将不可用" FontSize="12"
                                       Foreground="{StaticResource Status.Warning}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="确认" Style="{StaticResource DangerOutlineButton}" Width="56"
                                    Command="{Binding ConfirmLogoutCommand}" Margin="0,0,6,0"/>
                            <Button Content="取消" Style="{StaticResource OutlineButton}" Width="56"
                                    Command="{Binding CancelLogoutCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 检查更新：不依赖登录态（GitHub 直连 + 服务器兜底） -->
                    <StackPanel Margin="0,28,0,0" HorizontalAlignment="Center">
                        <Button Content="⟳ 检查更新" Style="{StaticResource OutlineButton}" Width="140" Height="30"
                                Command="{Binding CheckUpdateCommand}"/>
                        <Button Content="{Binding UpdateButtonText}" Style="{StaticResource PrimaryButton}" Width="160" Height="32"
                            Margin="0,8,0,0" Command="{Binding UpdateCommand}"
                            Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}"/>
                        <ProgressBar Width="240" Height="5" Minimum="0" Maximum="100" Margin="0,10,0,0"
                                     Value="{Binding UpdateProgress, Mode=OneWay}" Background="{StaticResource Bg.Card}"
                                 Foreground="{StaticResource Accent.Primary}" BorderThickness="0"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,8,0,0"
                                   Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Connector 管理页 -->
            <Grid Grid.Column="1" x:Name="ConnectorsPage" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具条 -->
                <DockPanel Grid.Row="0">
                    <TextBlock Text="本机 Max 版本" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟳ 重新检测" Style="{StaticResource OutlineButton}"
                                Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding InstallAllText}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallAllCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 批量安装总进度 -->
                <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="100" Margin="0,0,0,8"
                             Value="{Binding BatchProgress, Mode=OneWay}"
                             Background="{StaticResource Bg.Card}" BorderThickness="0"
                             Foreground="{StaticResource Accent.Primary}"
                             Visibility="{Binding IsBatchInstalling, Converter={StaticResource BoolToVis}}"/>

                <!-- 提示条 -->
                <Border Grid.Row="2" Background="{StaticResource Bg.Card}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Banner}" FontSize="12" Foreground="{StaticResource Status.Warning}"/>
                </Border>

                <!-- 版本列表 -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <Border Background="{StaticResource Bg.Card}" CornerRadius="4" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="88"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InstallDir}" FontSize="12"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallDir}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#3A3D42"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="Installed">
                                                                <Setter Property="Background" Value="#1B3B2A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="UpdateAvailable">
                                                                <Setter Property="Background" Value="#3D3320"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="Installing">
                                                                <Setter Property="Background" Value="#1E3448"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="Failed">
                                                                <Setter Property="Background" Value="#42272A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#9BA0A6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusName}" Value="Installed">
                                                                    <Setter Property="Foreground" Value="#4CC38A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusName}" Value="UpdateAvailable">
                                                                    <Setter Property="Foreground" Value="#F0B429"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusName}" Value="Installing">
                                                                    <Setter Property="Foreground" Value="#4C9FE0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusName}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="#E5534B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Button Grid.Column="3" Content="{Binding ActionText}" Width="80"
                                                    Command="{Binding ActionCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="Installed">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#9BA0A6"/>
                                                                <Setter Property="BorderBrush" Value="#3D4147"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="Installing">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <!-- 安装进度：模拟递增，完成后冲刺到 100% -->
                                        <ProgressBar Grid.Row="1" Height="3" Minimum="0" Maximum="100" Margin="0,0,0,4"
                                                     Value="{Binding Progress, Mode=OneWay}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource Accent.Primary}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusName}" Value="Installing">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        </Grid>
                                    </Border>
                                    <!-- 行内错误条 -->
                                    <Border Background="#2AE5534B" BorderBrush="{StaticResource Status.Danger}" BorderThickness="2,0,0,0"
                                            Padding="10,4" Margin="0,2,0,0"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource Status.Danger}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 底部提示 -->
                <TextBlock Grid.Row="4" Text="ⓘ 安装后请重启 3ds Max，面板将出现在 宏/工具栏 中" FontSize="12"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,8,0,0"/>
            </Grid>

            <!-- 工具管理页 -->
            <Grid Grid.Column="1" x:Name="ToolsPage" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具条 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="工具管理" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟳ 刷新" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                                Command="{Binding RefreshCommand}"/>
                        <Button Content="卸载全部本机工具" Style="{StaticResource DangerOutlineButton}"
                                Command="{Binding UninstallAllCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 提示条 -->
                <Border Grid.Row="1" Background="{StaticResource Bg.Card}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Banner}" FontSize="12" Foreground="{StaticResource Status.Warning}"/>
                </Border>

                <!-- 三个功能页 -->
                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                    <!-- 本机已安装 -->
                    <TabItem Header="本机工具">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="已安装工具（卸载依据本机账本，安全回滚）" FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InstalledTools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,4">
                                                <Border Background="{StaticResource Bg.Card}" CornerRadius="4" Height="44" Padding="12,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="13"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Display}"/>
                                                        <Button Grid.Column="1" Content="卸载" Width="64"
                                                                Style="{StaticResource OutlineButton}" VerticalAlignment="Center"
                                                                Command="{Binding UninstallCommand}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- 市场安装 -->
                    <TabItem Header="市场">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="安装目标 Max 版本：" FontSize="13" VerticalAlignment="Center"/>
                                <ComboBox Width="120" ItemsSource="{Binding MaxYears}" SelectedItem="{Binding SelectedMaxYear}"
                                          VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="从服务器市场安装工具（审核通过的脚本自动出现在这里）" FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MarketTools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,4">
                                                <Border Background="{StaticResource Bg.Card}" CornerRadius="4" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text="{Binding LatestVersion, StringFormat=v{0}}" FontSize="11"
                                                                       Foreground="{StaticResource Text.Secondary}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12"
                                                                   Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="3" Content="安装" Width="64"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Command="{Binding InstallCommand}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- 本地上传 -->
                    <TabItem Header="上传脚本">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="选择本地脚本（.ms / .py），自动识别名称与描述后提交审核" FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,10"/>
                            <Button Grid.Row="1" Content="{Binding PickFileText}"
                                    Style="{StaticResource OutlineButton}" Height="36" HorizontalAlignment="Stretch"
                                    Command="{Binding PickFileCommand}"/>
                            <TextBlock Grid.Row="2" Text="名称" FontSize="12" Margin="0,10,0,4"/>
                            <TextBox Grid.Row="3" Text="{Binding UploadName, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                            <TextBlock Grid.Row="4" Text="描述" FontSize="12" Margin="0,10,0,4"/>
                            <TextBox Grid.Row="5" Text="{Binding UploadDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="版本" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding UploadVersion, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="28"/>
                                <TextBlock Text="Max" FontSize="12" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <ComboBox Width="70" ItemsSource="{Binding AllMaxYears}" SelectedItem="{Binding UploadMinMaxYear}"/>
                                <TextBlock Text="—" FontSize="12" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <ComboBox Width="70" ItemsSource="{Binding AllMaxYears}" SelectedItem="{Binding UploadMaxMaxYear}"/>
                                <Button Content="提交审核" Style="{StaticResource PrimaryButton}" Width="96" Height="30"
                                        Margin="16,0,0,0" Command="{Binding SubmitUploadCommand}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="7" Text="{Binding UploadStatus}" FontSize="12"
                                       Foreground="{StaticResource Status.Warning}" Margin="0,10,0,0"
                                       Visibility="{Binding HasUploadStatus, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <local:ReleaseNotesPage Grid.Column="1" x:Name="ReleaseNotesPage" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
