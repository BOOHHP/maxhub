<Window x:Class="MaxHub.Agent.Tray.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MaxHub Agent 更新日志" Width="660" Height="500"
        MinWidth="560" MinHeight="400" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg.Window}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg.Sidebar}" MouseLeftButtonDown="TitleBar_MouseDown">
            <DockPanel>
                <TextBlock Text="更新日志" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="✕"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭更新日志"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="MaxHub Agent" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding HeaderText}" FontSize="12" Margin="0,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WasJustUpdated}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Bg.Sidebar}" CornerRadius="4"
                        BorderBrush="{StaticResource Border.Default}" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" BorderThickness="0" Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,7"
                                                    BorderBrush="Transparent" BorderThickness="3,0,0,0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource Bg.CardHover}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource Bg.Card}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Note.Version, StringFormat=v{0}}" FontWeight="SemiBold"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                                        <Border DockPanel.Dock="Right" Background="#1B3B2A" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="当前" FontSize="10" Foreground="{StaticResource Status.Success}"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Note.Date}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{StaticResource Text.Disabled}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Border.Default}"/>

                <ScrollViewer Grid.Column="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedItem.Note.Version, StringFormat=v{0}}"
                                       FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedItem.Note.Date}" FontSize="12" Margin="16,0,0,0"
                                       Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding SelectedItem.Note.Summary}" TextWrapping="Wrap"
                                   FontSize="13" LineHeight="21" Margin="0,10,0,8"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.Note.Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent.Primary}"/>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="•" Foreground="{StaticResource Text.Secondary}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                                   FontSize="13" LineHeight="21"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0">
            <Button Content="知道了" Style="{StaticResource PrimaryButton}" Width="92" Height="30"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                    Click="Close_Click" AutomationProperties.Name="关闭更新日志"/>
        </Border>
    </Grid>
</Window>
