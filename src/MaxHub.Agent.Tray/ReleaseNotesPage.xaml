<UserControl x:Class="MaxHub.Agent.Tray.ReleaseNotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg.Window}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg.Card}" CornerRadius="8" Padding="16,13"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="更新日志" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="查看 MaxHub Agent 每个版本的新增、改进与修复" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding HeaderText}" FontSize="12" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WasJustUpdated}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg.Sidebar}" CornerRadius="8"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="1">
                <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0" Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="8,8"
                                                BorderBrush="Transparent" BorderThickness="3,0,0,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Bg.CardHover}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Bg.Card}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Note.Version, StringFormat=v{0}}" FontWeight="SemiBold"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                                    <Border Grid.Column="1" Background="{StaticResource Status.SuccessBg}" CornerRadius="6" Padding="5,1" Margin="8,0,0,0"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="当前" FontSize="10" Foreground="{StaticResource Status.Success}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Note.Date}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{StaticResource Text.Disabled}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Border.Default}"/>

            <ScrollViewer Grid.Column="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,14,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedItem.Note.Version, StringFormat=v{0}}"
                                   FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedItem.Note.Date}" FontSize="12" Margin="16,0,0,0"
                                   Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedItem.Note.Summary}" TextWrapping="Wrap"
                               FontSize="13" LineHeight="22" Margin="0,12,0,8"/>
                    <ItemsControl ItemsSource="{Binding SelectedItem.Note.Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent.Primary}"/>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="•" Foreground="{StaticResource Text.Secondary}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                               FontSize="13" LineHeight="22"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
